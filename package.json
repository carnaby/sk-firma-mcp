{
  "name": "sk-firma",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @skfirma/core --filter sk-firma-mcp-server build && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --filter @skfirma/core --filter sk-firma-mcp-server build && concurrently -n server,web \"pnpm --filter @skfirma/server dev\" \"pnpm --filter @skfirma/web dev\"",
    "start": "node apps/server/dist/main.js",
    "ingest": "node packages/mcp/dist/bin/ingest.js",
    "smoke": "node packages/mcp/scripts/smoke.mjs"
  },
  "dependencies": {
    "@skfirma/core": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
