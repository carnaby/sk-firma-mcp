{
  "name": "sk-firma",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/mcp",
    "apps/web",
    "apps/server"
  ],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run build -w @skfirma/core -w sk-firma-mcp-server && concurrently -n server,web \"npm run dev -w @skfirma/server\" \"npm run dev -w @skfirma/web\"",
    "start": "node apps/server/dist/main.js",
    "ingest": "node packages/mcp/dist/bin/ingest.js"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
